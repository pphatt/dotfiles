# Ignore everything
/*

# But not .gitignore itself
!.gitignore

# Unignore .config folder
!/.config/

# Unignore ide folder
!/ide/

# Unignore terminal folder
!/terminal/

# Unignore images folder
!/images/

# Unignore config README file
!/.config/README.md

# Unignore README file
!/README.md

# Ignore everything inside .config except for files
/.config/*

# Unignore powershell files inside .config
!/.config/powershell
